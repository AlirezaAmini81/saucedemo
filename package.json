{
  "name": "playwright-saucedemo-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly Playwright end-to-end test suite for the public SauceDemo website.",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com/",
    "install:browsers": "playwright install --with-deps"
  },
  "keywords": [
    "playwright",
    "typescript",
    "end-to-end-testing",
    "test-automation",
    "saucedemo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
